APP_ENV=development
APP_NAME=Ticketing Demo API
LOG_LEVEL=INFO
DEMO_DATA_ENABLED=true

SECRET_KEY=local-ticketing-demo-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
GUEST_CHECKOUT_ACCESS_EXPIRE_MINUTES=1440
VALIDATION_STATION_ACTIVATION_EXPIRE_MINUTES=10080
VALIDATION_STATION_SESSION_EXPIRE_MINUTES=2880
# Must be true in production, where access is always served over HTTPS.
VALIDATION_STATION_COOKIE_SECURE=false

POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://ticketing:ticketing@postgres:5432/ticketing

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_KEY_PREFIX=ticketing:rate-limit

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ticketing-demo.com
SMTP_FROM_NAME=Ticketing Demo
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_DELIVERY_ENABLED=true
ORGANIZER_CONTACT_EMAIL=admin@ticketing-demo.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@ticketing-demo.com

FRONTEND_BASE_URL=http://127.0.0.1:5173
BACKEND_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ticketing-media
S3_REGION=us-east-1
S3_USE_SSL=false

SUPERADMIN_EMAIL=admin@ticketing-demo.com
SUPERADMIN_PASSWORD=TicketingDemo2026!
SUPERADMIN_FULL_NAME=Portfolio Admin
